<IfModule mod_rewrite.c>
  RewriteEngine On

  # 0) Let real files pass through (but NOT directories)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 1) If a directory-style path has an index.html, serve it
  #    (works for any depth, with or without a trailing slash)
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [L]

  # 2) Canonicalize: if index.html exists but URL lacks trailing slash, redirect to add it
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+[^/])$ $1/ [R=301,L]

  # 3) For other extensionless URLs, add a trailing slash (your original behavior)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !(\.[a-zA-Z0-9]{1,5}|/)$
  RewriteRule (.*)$ /$1/ [R=301,L]
</IfModule>

# Caching
<IfModule mod_headers.c>
  # Default (HTML + the hand-written /member, /shop JS & CSS): always revalidate,
  # so edits go live immediately. ETag/Last-Modified still make these cheap 304s.
  Header set Cache-Control "no-cache"

  # Next.js build output is content-hashed — the filename changes when the file
  # does, so it never needs revalidating.
  SetEnvIf Request_URI "^/_next/static/" CACHE_IMMUTABLE
  Header set Cache-Control "public, max-age=31536000, immutable" env=CACHE_IMMUTABLE

  # Media, fonts and PDFs: large and rarely edited in place.
  # (env=!CACHE_IMMUTABLE so hashed files under /_next/static/media keep max-age above)
  <FilesMatch "\.(png|PNG|jpe?g|JPG|gif|webp|avif|svg|ico|pdf|woff2?|ttf|glb|obj|step|mp4|webm)$">
    Header set Cache-Control "public, max-age=604800" env=!CACHE_IMMUTABLE
  </FilesMatch>

  Header unset Expires
  Header unset Pragma
</IfModule>

# ETags from mtime+size only (no inode, so they stay stable across redeploys)
FileETag MTime Size

# ✅ Optional: better headers for sitemap & robots
<IfModule mod_headers.c>
  <Files "sitemap.xml">
    Header unset Set-Cookie
    Header set Cache-Control "public, max-age=86400"
    Header set Content-Type "application/xml; charset=UTF-8"
  </Files>
  <Files "robots.txt">
    Header set Content-Type "text/plain; charset=UTF-8"
  </Files>
</IfModule>

